[sub_resource type="Shader" id="Shader_Water"]
code = "shader_type spatial;
render_mode depth_draw_opaque,cull_back,diffuse_burley,specular_schlick_ggx;
uniform vec4 water_color:source_color=vec4(0.12,0.38,0.70,1.0);
uniform float wave_speed:hint_range(0.0,5.0)=0.6;
uniform float wave_scale:hint_range(0.1,10.0)=2.2;
uniform float wave_height:hint_range(0.0,1.0)=0.14;
void vertex(){
  float wx=abs(sin(VERTEX.x*wave_scale+TIME*wave_speed*2.8))*wave_height;
  float wz=abs(sin(VERTEX.z*wave_scale*1.3+TIME*wave_speed*2.1))*wave_height*0.6;
  VERTEX.y+=wx+wz;
}
void fragment(){
  float shimmer=sin(UV.x*12.0+TIME*wave_speed*3.0)*0.5+0.5;
  float flow=fract(UV.y*6.0-TIME*wave_speed*0.25);
  float highlight=smoothstep(0.38,0.52,flow)*0.08;
  vec3 deep=water_color.rgb;
  vec3 col=deep+vec3(shimmer*0.06,shimmer*0.09,shimmer*0.04)+vec3(highlight*0.6,highlight*0.7,highlight);
  ALBEDO=col;
  SPECULAR=0.9;
  ROUGHNESS=0.06;
}"

