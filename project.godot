; Engine configuration file.
; It's best to edit using the editor UI and not directly,
; but this serves as the initial project bootstrap.

[application]

config/name="Gold Mine"
config/description="California 1848. Start with a pan and a dream."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/icon.png"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.15, 0.12, 0.08, 1)
